# =============================================================
# Domu Backend — Plantilla de variables de entorno
# Copia este archivo a `.env` y ajusta los valores.
# El archivo `.env` real NUNCA se versiona (ver .gitignore).
# =============================================================

# --- Entorno y servidor ---
NODE_ENV=development
PORT=3000

# --- Base de datos MySQL 8.4 ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=domu
DB_PASSWORD=cambiar_en_local
DB_NAME=domu
DB_TEST_NAME=domu_test
DB_CONNECTION_LIMIT=10

# --- Autenticación JWT ---
# Obligatorio: mínimo 32 caracteres. Genera uno propio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiar_por_un_secreto_de_32_caracteres_o_mas
JWT_EXPIRES_IN=8h

# --- CORS (allowlist de orígenes permitidos, separados por coma) ---
CORS_ORIGIN=http://localhost:5173

# --- Seguridad ---
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
